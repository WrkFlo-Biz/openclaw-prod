# OpenClaw Production Environment Variables
# Copy this file to .env and fill in your values

# ===== REQUIRED =====

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_ADMIN_USER_ID=your_admin_user_id

# ===== OPTIONAL =====

# Telegram Additional Configuration
TELEGRAM_MAIN_CHAT_ID=your_main_chat_id
TELEGRAM_OPERATOR_USER_IDS=user_id_1,user_id_2
TELEGRAM_MONITOR_CHANNELS=channel_id_1,channel_id_2
TELEGRAM_ALERT_CHAT_ID=your_alert_chat_id

# GitHub Configuration
GITHUB_TOKEN=your_github_token
GITHUB_REPO=owner/repository

# API Health Monitoring
API_HEALTH_URL=https://your-api.com/health
DB_HEALTH_URL=https://your-db.com/health

# Price Monitoring
PRICE_MONITOR_ENABLED=false
PRICE_MONITOR_ASSETS=bitcoin,ethereum

# Docker Configuration
DOCKER_REGISTRY=docker.io/yourusername

# Backup Configuration
BACKUP_DESTINATION=/data/openclaw/backups
BACKUP_ENCRYPTION_KEY=your_encryption_key

# Database (if using database storage)
DATABASE_URL=postgresql://user:password@localhost:5432/openclaw

# S3 Storage (if using S3)
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# Logging
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
