[Unit]
Description=OpenClaw Gateway (Docker)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/openclaw/openclaw.env
Environment=OPENCLAW_IMAGE=wrkfloopenclawacr.azurecr.io/openclaw:latest
ExecStartPre=/usr/bin/az login --identity --allow-no-subscriptions
ExecStartPre=/usr/bin/az acr login --name wrkfloopenclawacr
ExecStartPre=-/usr/bin/docker pull ${OPENCLAW_IMAGE}
ExecStartPre=-/usr/bin/docker rm -f openclaw-gateway
ExecStart=/usr/bin/docker run --name openclaw-gateway --restart=no --env-file /etc/openclaw/openclaw.env -v /data/openclaw/.openclaw:/data/openclaw/.openclaw -p 127.0.0.1:18789:18789 ${OPENCLAW_IMAGE}
ExecStop=/usr/bin/docker stop openclaw-gateway
Restart=always
RestartSec=10
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
